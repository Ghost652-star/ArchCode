# ArchCode 配置示例
# 复制到 .archcode/config.yaml 并填入你的 API Key

providers:
  - name: default
    protocol: openai-compat   # openai-compat | openai | anthropic
    base_url: https://api.openai.com/v1
    model: gpt-4o-mini
    api_key: ${OPENAI_API_KEY}   # 或直接写 sk-xxx
    max_output_tokens: 4096
    # thinking: false            # anthropic 可开

# 可选：追加到系统提示词
# system_prompt: |
#   自定义指令。

# ── MCP 外部工具(可选)────────────────────────────────
# 支持任意遵循 MCP 协议的 server。两种 transport 二选一。
# 工具默认延迟加载,LLM 通过 ToolSearch 按需加载完整 schema。

mcp_servers:

  # stdio 类型:本地子进程(ArchCode spawn → 通过 stdin/stdout JSON-RPC 通信)
  - name: github
    command: npx
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "${GITHUB_PERSONAL_ACCESS_TOKEN}"

  - name: tavily
    command: npx
    args: ["-y", "tavily-mcp@latest"]
    env:
      TAVILY_API_KEY: "${TAVILY_API_KEY}"

  - name: filesystem
    command: npx
    args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/project"]

  - name: my_python_server
    command: python
    args: ["-m", "my_mcp_server"]

  - name: uvx_server
    command: uvx
    args: ["some-mcp-package"]

  # streamable_http 类型:远程 HTTP 服务(ArchCode 通过 HTTPS JSON-RPC 通信)
  - name: corp_gateway
    url: https://mcp.corp.example.com
    headers:
      Authorization: "Bearer ${MCP_TOKEN}"