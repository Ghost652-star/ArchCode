/* ArchCode 极简样式 —— 对照 mewcode/styles.tcss
   - 无粗边框：输入框 border:none，聊天区无边框
   - 只用细分割线（border-top: solid #303030）分隔区域
   - 弹窗完全内嵌，无盒子，靠 Rich markup 颜色区分
*/

Screen {
    layout: vertical;
}

#chat {
    height: 1fr;
    min-height: 18;
    padding: 0 1;
}

#input {
    height: auto;
    min-height: 1;
    max-height: 10;
    border: none;
    margin: 0 1;
}

.user-msg {
    padding: 0 2;
    margin: 0;
    color: $text;
}

.assistant-msg {
    padding: 0 2;
    margin: 0;
}

.thinking-msg {
    padding: 0 2;
    margin: 0;
    color: $text-muted;
    text-style: italic;
}

.system-msg {
    padding: 0 2;
    color: $text-muted;
    text-style: italic;
}

.error-msg {
    padding: 0 2;
    color: $error;
}

.tool-use-msg {
    padding: 0 2;
    color: $secondary;
}

.tool-result-msg {
    padding: 0 2;
    color: $text-muted;
}

.tool-result-msg-error {
    padding: 0 2;
    color: $error;
}

/* --- 内嵌权限/提问弹窗（无盒子，照搬 mewcode #perm-inline） --- */

.perm-modal {
    height: auto;
    padding: 0 0;
    margin: 1 0 1 0;
}

#perm-content {
    height: auto;
    width: 100%;
    padding: 0 0;
}

/* --- 状态栏（细分割线分隔） --- */

.status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    border-top: solid #303030;
}
